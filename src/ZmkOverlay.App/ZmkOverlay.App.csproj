<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- タスクトレイ常駐に NotifyIcon を使うため。WPF と併用できる。 -->
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- tools/make-icon.ps1 で生成する。直接編集しない。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ZmkOverlay</AssemblyName>
    <RootNamespace>ZmkOverlay.App</RootNamespace>

    <!-- 単一 exe で配布するときも WPF は Trim できないので指定しない。 -->
    <SelfContained>false</SelfContained>

    <!--
      WFAC010 / WFO0003（.NET 10 での名前）: WinForms は DPI 設定をマニフェストではなく
      API で行えと言うが、このアプリの UI は WPF で、WPF はマニフェストの PerMonitorV2 を見る。
      WinForms はトレイアイコンにしか使っていないので指摘は当たらない。
    -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZmkOverlay.Core\ZmkOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      トレイ用。exe のアイコン（ApplicationIcon）から取り出すと 32px の面しか得られず、
      高 DPI のトレイでぼやけるので、同じファイルを埋め込んで大きさの合う面を選ぶ。
    -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ZmkOverlay.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- レイアウトとキーマップは exe の隣に置く（ポータブル動作）。 -->
    <None Include="..\..\data\**\*.json"
          LinkBase="data"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
