<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- タスクトレイ常駐に NotifyIcon を使うため。WPF と併用できる。 -->
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- tools/make-icon.ps1 で生成する。直接編集しない。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ZmkOverlay</AssemblyName>
    <RootNamespace>ZmkOverlay.App</RootNamespace>

    <!-- 設定画面の「バージョン」と、配布 zip の名前（tools/publish.ps1）に使う。 -->
    <Version>0.1.0</Version>
    <Product>ZMK Keymap Overlay</Product>
    <Description>Shows your ZMK keymap on top of the screen</Description>
    <Copyright>Copyright (c) 2026 utori7</Copyright>

    <!-- 単一 exe で配布するときも WPF は Trim できないので指定しない。 -->
    <SelfContained>false</SelfContained>

    <!--
      WFAC010 / WFO0003（.NET 10 での名前）: WinForms は DPI 設定をマニフェストではなく
      API で行えと言うが、このアプリの UI は WPF で、WPF はマニフェストの PerMonitorV2 を見る。
      WinForms はトレイアイコンにしか使っていないので指摘は当たらない。
    -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>

    <!--
      WPF0001: 設定画面に使う ThemeMode（Windows 11 風の見た目、ライト/ダークに追従）は
      .NET 10 でも試験的 API 扱いで警告が出る。使うのは設定画面だけで、オーバーレイは自前で描いている。
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZmkOverlay.Core\ZmkOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      トレイ用。exe のアイコン（ApplicationIcon）から取り出すと 32px の面しか得られず、
      高 DPI のトレイでぼやけるので、同じファイルを埋め込んで大きさの合う面を選ぶ。
    -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ZmkOverlay.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- レイアウトとキーマップは exe の隣に置く（ポータブル動作）。 -->
    <None Include="..\..\data\**\*.json"
          LinkBase="data"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
