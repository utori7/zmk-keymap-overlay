<Window x:Class="ZmkOverlay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Yu Gothic UI">

    <!--
      文言はすべてコードビハインドの ApplyTexts で入れる。表示言語を切り替えたときに
      開いたまま入れ替えられるようにするため、ここには書かない。
    -->

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Nav" Grid.Column="0" Margin="12,16,4,16" BorderThickness="0"
                 Background="Transparent" SelectionChanged="OnNavChanged">
            <ListBoxItem x:Name="NavKeyboard" />
            <ListBoxItem x:Name="NavDisplay" />
            <ListBoxItem x:Name="NavSync" />
            <ListBoxItem x:Name="NavShortcuts" />
            <ListBoxItem x:Name="NavGeneral" />
        </ListBox>

        <Grid Grid.Column="1" Margin="12,16,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,24,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,24,0">
                <Grid>

                    <!-- ===== キーボード ===== -->
                    <StackPanel x:Name="KeyboardPage">
                        <TextBlock x:Name="SampleNote" Style="{StaticResource Note}" Opacity="1" FontWeight="SemiBold" />

                        <TextBlock x:Name="KeymapSection" Style="{StaticResource Section}" Margin="0,8,0,8" />
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="KeymapFileLabel" Style="{StaticResource FieldLabel}" />
                            <Button x:Name="KeymapBrowse" DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0" Click="OnBrowseKeymap" />
                            <TextBlock x:Name="KeymapPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="LayoutFileLabel" Style="{StaticResource FieldLabel}" />
                            <Button x:Name="LayoutBrowse" DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0" Click="OnBrowseLayout" />
                            <Button x:Name="LayoutAuto" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnLayoutAuto" />
                            <TextBlock x:Name="LayoutPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Button x:Name="ReloadButton" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnReload" />

                        <TextBlock x:Name="HostLayoutSection" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="HostJis" GroupName="HostLayout" Margin="0,0,24,0" Checked="OnHostLayoutChecked" />
                            <RadioButton x:Name="HostUs" GroupName="HostLayout" Checked="OnHostLayoutChecked" />
                        </StackPanel>
                        <TextBlock x:Name="HostLayoutNote" Style="{StaticResource Note}" />

                        <TextBlock x:Name="LayerNamesSection" Style="{StaticResource Section}" />
                        <TextBlock x:Name="LayerNamesNote" Style="{StaticResource Note}" />
                        <StackPanel x:Name="LayerNamesList" />

                        <TextBlock x:Name="WarningsSection" Style="{StaticResource Section}" />
                        <TextBlock x:Name="NoWarnings" Style="{StaticResource Note}" />
                        <TextBox x:Name="WarningsBox" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- ===== 表示 ===== -->
                    <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
                        <TextBlock x:Name="ShowWhenSection" Style="{StaticResource Section}" Margin="0,8,0,8" />
                        <RadioButton x:Name="ModeLayersOnlyRadio" GroupName="Mode" Checked="OnModeChecked" />
                        <TextBlock x:Name="ModeLayersOnlyNote" Style="{StaticResource Note}" Margin="28,0,0,8" />
                        <RadioButton x:Name="ModeAlwaysRadio" GroupName="Mode" Checked="OnModeChecked" />
                        <TextBlock x:Name="ModeAlwaysNote" Style="{StaticResource Note}" Margin="28,0,0,8" />

                        <TextBlock x:Name="LookSection" Style="{StaticResource Section}" />
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="SizeLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="SizeSlider" Minimum="28" Maximum="80" TickFrequency="2"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSizeChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="OpacityLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnOpacityChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="PositionLabel" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PositionBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnPositionChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="MarginLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="MarginValue" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="MarginSlider" Minimum="0" Maximum="160" TickFrequency="4"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnMarginChanged" />
                        </DockPanel>

                        <TextBlock x:Name="PreviewSection" Style="{StaticResource Section}" />
                        <!-- 半透過の見え方が分かるよう、画面の壁紙に近い色の上に置く。 -->
                        <Border CornerRadius="8" Padding="16" MinHeight="120">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF7B8BA3" Offset="0" />
                                    <GradientStop Color="#FF4E5B70" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <ContentControl x:Name="PreviewContent" />
                            </Viewbox>
                        </Border>
                    </StackPanel>

                    <!-- ===== レイヤー追従 ===== -->
                    <StackPanel x:Name="SyncPage" Visibility="Collapsed">
                        <TextBlock x:Name="SyncExplain" Style="{StaticResource Note}" Margin="0,8,0,12" />
                        <CheckBox x:Name="SyncEnabledBox" Click="OnSyncEnabledClick" />
                        <StackPanel Margin="28,8,0,0">
                            <RadioButton x:Name="SyncHoldRadio" GroupName="SyncMode" Margin="0,0,0,4" Checked="OnSyncModeChecked" />
                            <RadioButton x:Name="SyncToggleRadio" GroupName="SyncMode" Checked="OnSyncModeChecked" />
                        </StackPanel>

                        <TextBlock x:Name="SignalSection" Style="{StaticResource Section}" />
                        <TextBlock x:Name="SignalNote" Style="{StaticResource Note}" />
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColumnLayer" FontWeight="SemiBold" />
                            <TextBlock x:Name="ColumnSignal" Grid.Column="1" FontWeight="SemiBold" />
                            <TextBlock x:Name="ColumnTest" Grid.Column="2" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel x:Name="SignalList" />
                        <TextBlock x:Name="SignalTestHint" Style="{StaticResource Note}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- ===== ショートカット ===== -->
                    <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed">
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Note}" Margin="0,8,0,10" />
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="ToggleHotkeyLabel" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HotkeyBox" Width="220" HorizontalAlignment="Left" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                                     PreviewKeyDown="OnHotkeyKeyDown" />
                        </DockPanel>

                        <TextBlock x:Name="LayerShortcutsSection" Style="{StaticResource Section}" />
                        <CheckBox x:Name="ManualKeysBox" Click="OnManualKeysClick" />
                        <TextBlock x:Name="ManualKeysNote" Style="{StaticResource Note}" Margin="28,0,0,10" />
                        <!-- レイヤーごとの入力欄。キーマップによって数が変わるのでコードで作る。 -->
                        <StackPanel x:Name="LayerShortcutList" />
                    </StackPanel>

                    <!-- ===== 全般 ===== -->
                    <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                        <DockPanel Margin="0,12,0,4">
                            <TextBlock x:Name="LanguageLabel" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged" />
                        </DockPanel>

                        <CheckBox x:Name="RunAtLoginBox" Margin="0,18,0,0" Click="OnRunAtLoginClick" />
                        <TextBlock x:Name="RunAtLoginNote" Style="{StaticResource Note}" Margin="28,0,0,0" />

                        <TextBlock x:Name="AboutSection" Style="{StaticResource Section}" />
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="ConfigFileLabel" Style="{StaticResource FieldLabel}" />
                            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenFolder" />
                            <TextBlock x:Name="ConfigPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock x:Name="VersionLabel" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="VersionText" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,8,24,0" Foreground="#FFC42B1C"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
