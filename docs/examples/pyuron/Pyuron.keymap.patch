Subject: [PATCH] add layer-entry signal keys for the keymap overlay

Apply from the root of zmk-config-Pyuron:

    git apply path/to/Pyuron.keymap.patch

Put layer-signal.dtsi in config/ first; it is not part of this patch.
If it does not apply, the same change is two edits by hand:
  - #include "layer-signal.dtsi" after the L_* defines
  - swap the four &lt on the last row of default_layer (arguments unchanged)
diff --git a/config/Pyuron.keymap b/config/Pyuron.keymap
index 25510f9..20754c4 100644
--- a/config/Pyuron.keymap
+++ b/config/Pyuron.keymap
@@ -15,6 +15,12 @@
 #define L_MOUSE  4   // click only           - trackball auto ON
 #define L_SYS    5   // bluetooth / boot     - Kana hold  (pos 38)
 
+/* Layer-entry signal keys for the PC-side keymap overlay.
+ * Must come after the L_* defines above. See docs/examples/pyuron/README.md in the
+ * ZmkOverlay project for what this does and how to verify it.
+ */
+#include "layer-signal.dtsi"
+
 /* ===== JIS (Japanese 106/109) symbol aliases =====
  * Precondition: OS keyboard layout = JIS on ALL hosts.
  * ZMK sends US-position HID codes; these map them to JIS output.
@@ -168,7 +174,7 @@
 &kp Q           &kp W          &kp E          &kp R          &kp T                                        &kp Y            &kp U            &kp I          &kp O          &kp P
 &hml LGUI A     &hml LALT S    &hml LCTRL D   &hml LSHFT F   &kp G                                        &kp H            &hmr RSHFT J     &hmr RCTRL K   &hmr RALT L    &hmr RGUI JP_QUOT
 &kp Z           &kp X          &kp C          &kp V          &kp B     &htp EXCLAMATION JP_YEN    &kp MINUS   &kp N         &kp M            &kp COMMA      &kp DOT        &kp SLASH
-&htp LSHFT TAB  &kp LCTRL      &lt L_SYM INT5  &lt L_NAV SPACE                                    &kp BACKSPACE   &lt L_FUNC ENTER   &lt L_SYS INT4   &htp DEL F10
+&htp LSHFT TAB  &kp LCTRL      &lt_sym L_SYM INT5  &lt_nav L_NAV SPACE                                    &kp BACKSPACE   &lt_func L_FUNC ENTER   &lt_sys L_SYS INT4   &htp DEL F10
             >;
         };
 

