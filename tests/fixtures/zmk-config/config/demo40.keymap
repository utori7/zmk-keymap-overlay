/*
 * Demo keymap for the ZMK Keymap Overlay tests.
 * Written for this repository (MIT). The keyboard is made up: see boards/shields/demo40.
 *
 * It mixes the things real keymaps do, so the parser meets them together:
 * home-row mods, plain hold-taps, layer-taps with named layers, Japanese (JIS) aliases,
 * nested modifier functions, Bluetooth and boot keys, combos limited to a layer,
 * and a layer that no key enters (a pointing device turns it on).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_BASE  0
#define L_SYM   1   // symbols and numbers  (thumb, pos 34)
#define L_NAV   2   // cursor and editing   (thumb, pos 35)
#define L_FUNC  3   // function keys        (thumb, pos 37)
#define L_MOUSE 4   // clicks; turned on by a pointing device, not by a key
#define L_SYS   5   // bluetooth and boot   (thumb, pos 38)

/* JIS: the keyboard sends US key positions; these are the keys that type each symbol on a JIS PC. */
#define JP_AT    LBKT
#define JP_LBKT  RBKT
#define JP_RBKT  BSLH
#define JP_COLON SQT
#define JP_YEN   INT3
#define JP_PLUS  LS(SEMI)
#define JP_ASTR  LS(SQT)
#define JP_DQT   LS(N2)
#define JP_AMPS  LS(N6)
#define JP_QUOT  LS(N7)
#define JP_LPAR  LS(N8)
#define JP_RPAR  LS(N9)
#define JP_EQUAL LS(MINUS)
#define JP_TILDE LS(EQUAL)
#define JP_GRAVE LS(LBKT)
#define JP_LBRC  LS(RBKT)
#define JP_RBRC  LS(BSLH)
#define JP_UNDER LS(INT1)
#define JP_PIPE  LS(INT3)

/* Key positions, for hold-trigger-key-positions. */
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37 38 39

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        htp: hold_tap_plain {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&caps_word>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp ESC>;
        };

        combo_left_bracket {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp JP_LBKT>;
            layers = <L_BASE>;
        };

        combo_right_bracket {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&kp JP_RBKT>;
            layers = <L_BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E             &kp R             &kp T                                                     &kp Y             &kp U             &kp I             &kp O             &kp P
&hml LGUI A       &hml LALT S       &hml LCTRL D      &hml LSHFT F      &kp G                                                     &kp H             &hmr RSHFT J      &hmr RCTRL K      &hmr RALT L       &hmr RGUI JP_QUOT
&kp Z             &kp X             &kp C             &kp V             &kp B             &htp EXCLAMATION JP_YEN &kp MINUS         &kp N             &kp M             &kp COMMA         &kp DOT           &kp SLASH
                  &htp LSHFT TAB    &kp LCTRL         &lt L_SYM INT5    &lt L_NAV SPACE                                           &kp BACKSPACE     &lt L_FUNC ENTER  &lt L_SYS INT4    &htp DEL F10
            >;
        };

        sym_layer {
            bindings = <
&kp MINUS         &kp N7            &kp N8            &kp N9            &kp JP_PLUS                                               &kp JP_AT         &kp JP_AMPS       &kp JP_LBRC       &kp JP_RBRC       &kp JP_PIPE
&kp SLASH         &kp N4            &kp N5            &kp N6            &kp JP_ASTR                                               &kp EXCLAMATION   &kp JP_DQT        &kp JP_LPAR       &kp JP_RPAR       &kp JP_UNDER
&mt LSHFT N0      &kp N1            &kp N2            &kp N3            &kp DOT           &kp JP_EQUAL      &kp HASH          &kp DOLLAR        &kp PERCENT       &kp JP_LBKT       &kp JP_RBKT       &kp JP_COLON
                  &none             &none             &trans            &none                                                     &trans            &trans            &kp JP_TILDE      &kp JP_GRAVE
            >;
        };

        nav_layer {
            bindings = <
&kp ESC           &kp LC(LS(TAB))   &kp LC(TAB)       &kp LG(TAB)       &kp PG_UP                                                 &kp HOME          &kp PG_DN         &kp UP            &kp END           &kp DEL
&kp LGUI          &kp LG(LS(LEFT_ARROW)) &kp LCTRL         &kp LSHFT         &kp LG(LS(RIGHT_ARROW))                                         &kp C_VOL_UP      &kp LEFT          &kp DOWN          &kp RIGHT         &kp C_VOL_DN
&trans            &kp LA(LEFT_ARROW) &kp LA(RIGHT_ARROW) &kp LC(Z)         &kp LC(X)         &trans            &trans            &kp LC(C)         &kp LC(V)         &kp LC(LEFT)      &kp LC(RIGHT)     &trans
                  &trans            &trans            &trans            &trans                                                    &trans            &trans            &trans            &trans
            >;
        };

        func_layer {
            bindings = <
&kp F1            &kp F2            &kp F3            &kp F4            &kp F5                                                    &kp F6            &kp F7            &kp F8            &kp F9            &kp F10
&kp F11           &kp F12           &none             &none             &none                                                     &none             &mkp LCLK         &mkp MCLK         &mkp RCLK         &none
&trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                  &trans            &trans            &trans            &trans                                                    &trans            &trans            &trans            &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans            &trans            &trans            &trans            &trans                                                    &trans            &trans            &trans            &trans            &trans
&trans            &trans            &trans            &trans            &trans                                                    &trans            &mkp LCLK         &mkp MCLK         &mkp RCLK         &trans
&trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                  &trans            &trans            &trans            &trans                                                    &trans            &trans            &trans            &trans
            >;
        };

        sys_layer {
            bindings = <
&none             &none             &none             &none             &none                                                     &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4
&none             &none             &none             &none             &none                                                     &none             &none             &none             &none             &none
&bt BT_CLR        &none             &none             &none             &bootloader       &none             &none             &sys_reset        &none             &none             &none             &none
                  &trans            &trans            &trans            &trans                                                    &trans            &trans            &trans            &trans
            >;
        };
    };
};
